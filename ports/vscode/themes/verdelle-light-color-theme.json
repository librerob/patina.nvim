  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#45676B"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#733323"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#0E6C5F"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#7A5C15"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#604061"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#255098"
      }
    },
    {
      "scope": [
        "variable",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#132B2D"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#263E41"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#3E5457"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#733323"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0E6C5F"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0E6C5F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#0E6C5F"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B92935"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#132B2D",
    "parameter": "#132B2D",
    "property": "#132B2D",
    "function": "#0E6C5F",
    "method": "#0E6C5F",
    "class": "#255098",
    "interface": "#255098",
    "struct": "#255098",
    "enum": "#255098",
    "type": "#255098",
    "typeParameter": "#255098",
    "namespace": "#255098",
    "enumMember": "#604061",
    "variable.readonly": "#604061",
    "keyword": "#733323",
    "comment": "#45676B",
    "string": "#7A5C15",
    "number": "#604061",
    "operator": "#263E41"
  }
}
