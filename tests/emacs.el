;;; emacs.el --- Verdelle theme regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'json)
(require 'cl-lib)
(require 'ansi-color)
(require 'font-lock)
(require 'diff-mode)
(require 'org)

(defconst verdelle-test-root
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(dolist (directory '("ports/emacs" "ports/doom-emacs"))
  (add-to-list 'custom-theme-load-path (expand-file-name directory verdelle-test-root)))

(defun verdelle-test-palette (light)
  (let ((json-object-type 'alist) (json-array-type 'list) (json-key-type 'symbol))
    (json-read-file (expand-file-name (if light "palette/light.json" "palette/dark.json") verdelle-test-root))))

(defun verdelle-test-theme (theme light)
  (mapc #'disable-theme custom-enabled-themes)
  ;; These faces are normally defined by optional packages or newer Emacs versions.
  (dolist (face '(eglot-inlay-hint lsp-lens-face font-lock-operator-face font-lock-punctuation-face))
    (unless (facep face) (make-face face)))
  (dotimes (index 16)
    (let ((face (intern (format "vterm-color-%d" index))))
      (unless (facep face) (make-face face))))
  (load-theme theme t)
  (let* ((data (verdelle-test-palette light))
         (p (alist-get 'colors data))
         (ansi (alist-get 'ansi data)))
    (should (memq theme custom-enabled-themes))
    (dolist (pair '((default . fg) (font-lock-keyword-face . keyword)
                    (font-lock-string-face . string) (font-lock-function-name-face . func)
                    (font-lock-constant-face . constant) (font-lock-type-face . type)
                    (font-lock-comment-face . comment) (font-lock-operator-face . operator)
                    (font-lock-punctuation-face . punctuation) (eglot-inlay-hint . comment)
                    (lsp-lens-face . comment)))
      (should (equal (face-attribute (car pair) :foreground nil t) (alist-get (cdr pair) p))))
    (should (equal (face-attribute 'default :background) (alist-get 'bg p)))
    (should (equal (face-attribute 'region :foreground) (alist-get 'selection_fg p)))
    (should (equal (face-attribute 'region :background) (alist-get 'selection p)))
    (should (equal (face-attribute 'diff-added :foreground) (alist-get 'fg p)))
    (should (equal (face-attribute 'diff-added :background) (alist-get 'diff_add p)))
    (should (equal (face-attribute 'diff-removed :foreground) (alist-get 'error p)))
    (should (equal (face-attribute 'font-lock-comment-face :slant) 'normal))
    (should (equal (face-attribute 'lsp-lens-face :slant) 'normal))
    (should (equal (append ansi-color-names-vector nil) (cl-subseq ansi 0 8)))
    (dotimes (index 16)
      (should (equal (face-attribute (intern (format "vterm-color-%d" index)) :foreground)
                     (nth index ansi))))
    (should (eq frame-background-mode (if light 'light 'dark)))))

(ert-deftest verdelle-a-native-themes ()
  (dolist (item '((verdelle . nil) (verdelle-light . t) (verdelle . nil)))
    (verdelle-test-theme (car item) (cdr item)))
  (with-temp-buffer
    (insert-file-contents (expand-file-name "tests/fixtures/index.py" verdelle-test-root))
    (python-mode)
    (font-lock-ensure)
    (goto-char (point-min))
    (let ((case-fold-search nil))
      (search-forward "return"))
    (let ((face (get-text-property (1- (point)) 'face)))
      (should (if (listp face) (memq 'font-lock-keyword-face face)
                (eq face 'font-lock-keyword-face))))))

(ert-deftest verdelle-b-doom-themes ()
  (let ((directory (getenv "DOOM_THEMES_DIR")))
    (should directory)
    (add-to-list 'load-path directory)
    (require 'doom-themes)
    (dolist (item '((doom-verdelle . nil) (doom-verdelle-light . t) (doom-verdelle . nil)))
      (verdelle-test-theme (car item) (cdr item))
      (let ((p (alist-get 'colors (verdelle-test-palette (cdr item)))))
        (should (equal (doom-color 'keywords) (alist-get 'keyword p)))
        (should (equal (doom-color 'functions) (alist-get 'func p)))
        (should (equal (doom-color 'comments) (alist-get 'comment p)))))))

;;; emacs.el ends here
